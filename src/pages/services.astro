---
import Layout from "../layouts/Layout.astro";
import "../styles/services.css";
import {siteConfig} from "../config/site";
---

<Layout
  title="Website Development Services | {siteConfig.name}"
  description="{siteConfig.name} builds fast, professional websites and custom web applications tailored to your business requirements."
>

  <!-- ==================================================
       Hero
  ================================================== -->

  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">OUR SERVICES</p>

      <h1>
        We build the website your business actually needs.
      </h1>

      <p class="intro">
        From professional business websites to custom web applications,
         {siteConfig.name} builds digital solutions around your requirements—not the
        other way around.
      </p>
    </div>
  </section>


  <!-- ==================================================
       Business Websites
  ================================================== -->

  <section class="section">
    <div class="container">

      <div class="service-layout">

        <div class="service-intro">

          <p class="eyebrow">
            01 / BUSINESS WEBSITES
          </p>

          <h2>
            Fast, simple and professional.
          </h2>

          <p>
            A business website is a great choice when your primary goal is
            to present your company, services, products, portfolio, or
            information online.
          </p>

          <p>
            These websites are typically built as static sites, making them
            fast, secure, lightweight, and inexpensive to host.
          </p>

        </div>


        <div class="technology-card">

          <h3>
            Technologies we use
          </h3>

          <div class="tech-row">

            <strong>
              Astro
            </strong>

            <span>
              Modern, extremely fast websites with excellent performance
              and SEO capabilities.
            </span>

          </div>


          <div class="tech-row">

            <strong>
              WordPress
            </strong>

            <span>
              A flexible option when you want to manage website content
              yourself through a familiar dashboard.
            </span>

          </div>

        </div>

      </div>


      <div class="feature-grid">

        <div>
          <strong>
            Business Websites
          </strong>

          <p>
            Present your company, services, and contact information.
          </p>
        </div>


        <div>
          <strong>
            Landing Pages
          </strong>

          <p>
            Focused pages designed around a specific product or service.
          </p>
        </div>


        <div>
          <strong>
            Portfolio Websites
          </strong>

          <p>
            Showcase your work, projects, skills, and achievements.
          </p>
        </div>


        <div>
          <strong>
            Content Websites
          </strong>

          <p>
            Publish information, tutorials, articles, and other content.
          </p>
        </div>

      </div>

    </div>
  </section>


  <!-- ==================================================
       Web Applications
  ================================================== -->

  <section class="section section-light">
    <div class="container">

      <div class="service-layout">

        <div class="service-intro">

          <p class="eyebrow">
            02 / WEB APPLICATIONS
          </p>

          <h2>
            For businesses that need more than pages.
          </h2>

          <p>
            Web applications are designed for businesses that need to work
            with data, users, accounts, dashboards, content management
            systems, or other custom functionality.
          </p>

          <p>
            These projects can be built around your specific business
            processes and requirements.
          </p>

        </div>


        <div class="technology-card">

          <h3>
            Our technology stack
          </h3>


          <div class="stack">

            <div class="stack-item">

              <strong>
                React
              </strong>

              <span>
                Interactive application interfaces
              </span>

            </div>


            <div class="stack-item">

              <strong>
                Strapi
              </strong>

              <span>
                Content management and APIs
              </span>

            </div>


            <div class="stack-item">

              <strong>
                Database
              </strong>

              <span>
                Structured application data
              </span>

            </div>

          </div>

        </div>

      </div>


      <div class="feature-grid">

        <div>

          <strong>
            Web Applications
          </strong>

          <p>
            Custom applications designed around your business workflow.
          </p>

        </div>


        <div>

          <strong>
            CMS Integration
          </strong>

          <p>
            Manage and publish content through a dedicated interface.
          </p>

        </div>


        <div>

          <strong>
            Database Applications
          </strong>

          <p>
            Store, retrieve, and manage structured business information.
          </p>

        </div>


        <div>

          <strong>
            User Accounts
          </strong>

          <p>
            Build applications that require users, authentication, and
            roles.
          </p>

        </div>

      </div>

    </div>
  </section>


  <!-- ==================================================
       Choosing the Right Solution
  ================================================== -->

  <section class="section">

    <div class="container">

      <div class="section-heading">

        <p class="eyebrow">
          WHICH SOLUTION IS RIGHT FOR YOU?
        </p>

        <h2>
          Start with what you need your website to do.
        </h2>

        <p>
          You don't need to understand web development to choose the right
          solution. Tell us what you want your website to accomplish, and
          we'll recommend the appropriate approach.
        </p>

      </div>


      <div class="comparison">

        <!-- Business Website -->

        <div class="comparison-column">

          <h3>
            Business Website
          </h3>

          <p class="comparison-intro">
            A good fit if your primary goal is to establish a professional
            online presence.
          </p>

          <ul>

            <li>
              You mainly need to showcase your business.
            </li>

            <li>
              You need pages such as Home, Services, and Contact.
            </li>

            <li>
              You want excellent loading speed.
            </li>

            <li>
              You don't need complex user accounts.
            </li>

            <li>
              You want simple, reliable hosting.
            </li>

          </ul>

        </div>


        <!-- Web Application -->

        <div class="comparison-column">

          <h3>
            Web Application
          </h3>

          <p class="comparison-intro">
            A good fit if your website needs data, users, or custom
            application functionality.
          </p>

          <ul>

            <li>
              Your website needs a database.
            </li>

            <li>
              Users need accounts or login functionality.
            </li>

            <li>
              You need dashboards or custom workflows.
            </li>

            <li>
              You need advanced content management.
            </li>

            <li>
              Your website needs application-like functionality.
            </li>

          </ul>

        </div>

      </div>

    </div>

  </section>


  <!-- ==================================================
       CTA
  ================================================== -->

  <section class="cta">

    <div class="container cta-content">

      <p class="eyebrow">
        LET'S BUILD SOMETHING
      </p>

      <h2>
        Not sure which solution is right for you?
      </h2>

      <p>
        Tell us what you want your website to do. We'll help you determine
        the appropriate solution for your business.
      </p>

      <a
        href="/contact/"
        class="button button-primary"
      >
        Discuss Your Project
      </a>

    </div>

  </section>

</Layout>