---
import Layout from "../layouts/Layout.astro";
import "../styles/contact.css";
import {siteConfig} from "../config/site"
---

<Layout
  title={`Contact ${siteConfig.name} | Start Your Website Project`}
  description="Tell ${siteConfig.name} about your business and website requirements. We'll help you choose the right website solution for your needs."
>
  <!-- Hero -->
  <section class="contact-hero">
    <div class="container">
      <p class="eyebrow">START A PROJECT</p>

      <h1>
        Let's build something
        <span>for your business.</span>
      </h1>

      <p class="contact-intro">
        Tell us about your business, what you need, and what you want your
        website to accomplish. You don't need to know the technical details —
        we'll help you figure out the right solution.
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section contact-section">
    <div class="container contact-layout">

      <!-- Information -->
      <div class="contact-info">
        <p class="eyebrow">TELL US ABOUT YOUR PROJECT</p>

        <h2>
          Start with what
          <span>you need.</span>
        </h2>

        <p class="contact-info-text">
          Whether you need a simple business website, an online presence for
          your new business, or a more advanced web application, we'll start
          by understanding your requirements.
        </p>

        <div class="contact-points">

          <div class="contact-point">
            <div class="contact-point-number">01</div>

            <div>
              <h3>Tell us about your business</h3>

              <p>
                What does your business do and who are your customers?
              </p>
            </div>
          </div>

          <div class="contact-point">
            <div class="contact-point-number">02</div>

            <div>
              <h3>Tell us what you need</h3>

              <p>
                Describe the website or functionality you have in mind.
              </p>
            </div>
          </div>

          <div class="contact-point">
            <div class="contact-point-number">03</div>

            <div>
              <h3>We'll suggest the right approach</h3>

              <p>
                We'll help you determine the appropriate website solution
                based on your requirements.
              </p>
            </div>
          </div>

        </div>
      </div>

      <!-- Form -->
      <div class="contact-form-wrapper">

        <form class="contact-form">

          <div class="form-group">
            <label for="name">
              Your Name
              <span>*</span>
            </label>

            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              placeholder="Your full name"
              required
            />
          </div>

          <div class="form-group">
            <label for="email">
              Email Address
              <span>*</span>
            </label>

            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="you@example.com"
              required
            />
          </div>

          <div class="form-group">
            <label for="company">
              Business / Company
            </label>

            <input
              id="company"
              name="company"
              type="text"
              autocomplete="organization"
              placeholder="Your business name"
            />
          </div>

          <div class="form-group">
            <label for="website-type">
              What do you need?
              <span>*</span>
            </label>

            <select
              id="website-type"
              name="website_type"
              required
            >
              <option value="" selected disabled>
                Select an option
              </option>

              <option value="business-website">
                Business Website
              </option>

              <option value="landing-page">
                Landing Page
              </option>

              <option value="portfolio">
                Portfolio Website
              </option>

              <option value="ecommerce">
                E-commerce Website
              </option>

              <option value="web-application">
                Web Application
              </option>

              <option value="cms">
                CMS / Content Website
              </option>

              <option value="other">
                Something Else
              </option>
            </select>
          </div>

          <div class="form-group">
            <label for="budget">
              Approximate Budget
            </label>

            <select id="budget" name="budget">
              <option value="" selected disabled>
                Select a budget range
              </option>

              <option value="under-15k">
                Under ₹15,000
              </option>

              <option value="15k-30k">
                ₹15,000 – ₹30,000
              </option>

              <option value="30k-60k">
                ₹30,000 – ₹60,000
              </option>

              <option value="60k-1l">
                ₹60,000 – ₹1,00,000
              </option>

              <option value="1l-plus">
                ₹1,00,000+
              </option>

              <option value="not-sure">
                I'm not sure yet
              </option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">
              Tell us about your project
              <span>*</span>
            </label>

            <textarea
              id="message"
              name="message"
              rows="6"
              placeholder="What does your business do? What would you like your website to do?"
              required
            ></textarea>
          </div>

          <button
            type="submit"
            class="button button-primary form-submit"
          >
            Send Project Request →
          </button>

          <p class="form-note">
            We'll review your requirements and get back to you.
          </p>

        </form>

      </div>

    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="contact-cta">
    <div class="container contact-cta-content">

      <p class="eyebrow">NOT SURE WHERE TO START?</p>

      <h2>
        That's completely fine.
      </h2>

      <p>
        You don't need to know whether you need a static website, a CMS,
        a database, or a web application. Just explain what you want to
        achieve and we'll help you determine the right solution.
      </p>

      <a href="/services" class="button button-secondary">
        Explore Our Services →
      </a>

    </div>
  </section>
</Layout>